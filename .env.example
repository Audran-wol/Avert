# High-res satellite/hybrid imagery (optional). Free key: https://cloud.maptiler.com/account/keys/
# Copy this file to .env.local and paste your key. Without it, Satellite falls back to free Esri imagery.
VITE_MAPTILER_KEY=

# Ask Avert — server-side only, never exposed to the browser. Without OPENAI_API_KEY, Ask Avert
# shows an honest "unavailable" state and the rest of the app keeps working.
OPENAI_API_KEY=
# Optional: point at an Azure OpenAI resource's OpenAI-compatible v1 endpoint instead of
# plain OpenAI, e.g. https://<resource>.openai.azure.com/openai/v1 — auth header switches to
# `api-key` automatically when this host contains "azure.com". Leave blank for api.openai.com.
OPENAI_BASE_URL=
# For Azure this is your deployment name (not a public OpenAI model id).
OPENAI_MODEL=gpt-4o-mini
